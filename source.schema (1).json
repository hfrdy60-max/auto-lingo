{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source list",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id",
      "type",
      "publisher",
      "title",
      "document_edition",
      "url",
      "hosted_on",
      "accessed",
      "page_numbering",
      "pages_cited",
      "pages_cited_note",
      "anomalies"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "pattern": "^src-\\d{3}$"
      },
      "type": {
        "enum": [
          "official_manufacturer_manual",
          "official_manufacturer_website",
          "official_manufacturer_video"
        ]
      },
      "publisher": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "document_edition": {
        "type": "string"
      },
      "url": {
        "type": "string",
        "pattern": "^https://"
      },
      "hosted_on": {
        "type": "string"
      },
      "accessed": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "page_numbering": {
        "type": "string"
      },
      "pages_cited": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "front_matter",
          "numbered"
        ],
        "properties": {
          "front_matter": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[ivx]+$"
            }
          },
          "numbered": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 1
                },
                "to": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "pages_cited_note": {
        "type": "string"
      },
      "anomalies": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page",
            "text"
          ],
          "properties": {
            "page": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}