{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AUTONEX technical source registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "source_id",
      "type",
      "title",
      "url",
      "accessed",
      "page_numbering",
      "pages_used",
      "pages_cited",
      "document_edition"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "type": "string",
        "minLength": 1
      },
      "publisher": {
        "type": "string"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": [
          "string",
          "null"
        ]
      },
      "hosted_on": {
        "type": "string"
      },
      "accessed": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "page_numbering": {
        "type": "string",
        "minLength": 1
      },
      "pages_used": {
        "type": "string",
        "minLength": 1
      },
      "pages_cited": {
        "type": "object",
        "required": [
          "front_matter",
          "numbered"
        ],
        "properties": {
          "front_matter": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "numbered": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 1
                },
                "to": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "notes": {
        "type": "string"
      },
      "document_edition": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": true
  }
}
