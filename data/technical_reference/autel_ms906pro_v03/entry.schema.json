{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AUTO LINGO diagnostic term entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "brand",
    "device_id",
    "applies_to",
    "source_document",
    "device_software",
    "context",
    "menu_path",
    "path_confidence",
    "ui_element_type",
    "path_prerequisite",
    "path_note",
    "menu_path_alternatives",
    "category",
    "term_en",
    "term_en_as_written_in_manual",
    "term_variants_in_manual",
    "term_fa",
    "pronunciation_fa",
    "technical_description_fa",
    "usage_fa",
    "usage_basis",
    "related_terms",
    "workshop_example_fa",
    "workshop_example_basis",
    "cross_brand_equivalents",
    "media_ids",
    "source_refs",
    "verification",
    "notes",
    "last_checked"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "id": {
      "type": "string",
      "pattern": "^autel-ms906pro-[a-z0-9-]+$"
    },
    "brand": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "document_edition",
        "note"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "document_edition": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "device_software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_software_version",
        "status",
        "note"
      ],
      "properties": {
        "diagnostic_software_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "not_documented_in_source",
            "documented"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "context": {
      "enum": [
        "Vehicle-specific diagnosis",
        "Generic OBDII/EOBD",
        "Service"
      ]
    },
    "menu_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "path_confidence": {
      "enum": [
        "documented",
        "documented_vehicle_dependent",
        "section_documented_leaf_unconfirmed",
        "ui_element_on_screen"
      ]
    },
    "ui_element_type": {
      "type": "string"
    },
    "path_prerequisite": {
      "type": "string"
    },
    "path_note": {
      "type": "string"
    },
    "menu_path_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "basis",
          "confidence"
        ],
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "basis": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          }
        }
      }
    },
    "category": {
      "type": "string"
    },
    "term_en": {
      "type": "string",
      "minLength": 1
    },
    "term_en_as_written_in_manual": {
      "type": "string"
    },
    "term_variants_in_manual": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "printed_pages"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "printed_pages": {
            "type": "string",
            "pattern": "^(\\d+|[ivx]+)(-(\\d+|[ivx]+))?(; (\\d+|[ivx]+)(-(\\d+|[ivx]+))?)*$"
          }
        }
      }
    },
    "term_fa": {
      "type": "string",
      "minLength": 1
    },
    "pronunciation_fa": {
      "type": "string",
      "minLength": 1
    },
    "technical_description_fa": {
      "type": "string",
      "minLength": 10
    },
    "usage_fa": {
      "type": "string",
      "minLength": 10
    },
    "usage_basis": {
      "type": "string",
      "pattern": "^(\\d+|[ivx]+)(-(\\d+|[ivx]+))?(; (\\d+|[ivx]+)(-(\\d+|[ivx]+))?)*$"
    },
    "related_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "target_id",
          "target_context",
          "relation",
          "basis",
          "source_pages",
          "note"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_context": {
            "type": [
              "string",
              "null"
            ]
          },
          "relation": {
            "enum": [
              "parent",
              "child",
              "sibling",
              "alias",
              "contrast",
              "see_also",
              "part_of_screen",
              "status_label"
            ]
          },
          "basis": {
            "enum": [
              "manual",
              "author_editorial"
            ]
          },
          "source_pages": {
            "type": "string",
            "pattern": "^(\\d+|[ivx]+)(-(\\d+|[ivx]+))?(; (\\d+|[ivx]+)(-(\\d+|[ivx]+))?)*$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "workshop_example_fa": {
      "type": "string",
      "minLength": 150
    },
    "workshop_example_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_fa",
          "printed_page"
        ],
        "properties": {
          "fact_fa": {
            "type": "string"
          },
          "printed_page": {
            "type": "string",
            "pattern": "^(\\d+|[ivx]+)(-(\\d+|[ivx]+))?(; (\\d+|[ivx]+)(-(\\d+|[ivx]+))?)*$"
          }
        }
      }
    },
    "cross_brand_equivalents": {
      "type": "array"
    },
    "media_ids": {
      "type": "array"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "printed_page",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-\\d{3}$"
          },
          "printed_page": {
            "type": "string",
            "pattern": "^(\\d+|[ivx]+)(-(\\d+|[ivx]+))?(; (\\d+|[ivx]+)(-(\\d+|[ivx]+))?)*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical",
        "translation",
        "workshop_example"
      ],
      "properties": {
        "technical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis",
            "source_id",
            "checked_fields",
            "vehicle_dependent",
            "path_confidence",
            "author_written_fields"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "partially_verified",
                "unverified",
                "needs_review"
              ]
            },
            "basis": {
              "enum": [
                "official_manufacturer_manual"
              ]
            },
            "source_id": {
              "type": "string"
            },
            "checked_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vehicle_dependent": {
              "type": "boolean"
            },
            "path_confidence": {
              "type": "string"
            },
            "author_written_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "covers",
            "reviewed_by",
            "reviewed_on"
          ],
          "properties": {
            "status": {
              "enum": [
                "draft_unreviewed",
                "reviewed",
                "approved"
              ]
            },
            "covers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_on": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "workshop_example": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scenario_origin",
            "documented_real_case",
            "technical_facts_source_backed"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "brief",
                "complete",
                "reviewed"
              ]
            },
            "scenario_origin": {
              "enum": [
                "author_generated_educational_scenario",
                "sourced"
              ]
            },
            "documented_real_case": {
              "type": "boolean"
            },
            "technical_facts_source_backed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
